{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/audit.event.recorded.v1.json",
  "title": "audit.event.recorded v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "audit.event.recorded" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "projectId": { "type": "string" },
    "pondId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["auditId", "serviceName", "resourceType", "action", "outcome", "occurredAt"],
      "properties": {
        "auditId": { "type": "string", "minLength": 1 },
        "actorUserId": { "type": "string" },
        "serviceName": { "type": "string", "minLength": 1 },
        "resourceType": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string" },
        "action": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
