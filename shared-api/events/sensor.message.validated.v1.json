{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/sensor.message.validated.v1.json",
  "title": "sensor.message.validated v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "projectId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "sensor.message.validated" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "projectId": { "type": "string", "minLength": 1 },
    "pondId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["sensorMessageId", "deviceId", "seqNo", "readingCount", "validatedAt"],
      "properties": {
        "sensorMessageId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "deviceCode": { "type": "string" },
        "seqNo": { "type": "integer", "minimum": 0 },
        "readingCount": { "type": "integer", "minimum": 0 },
        "validatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
