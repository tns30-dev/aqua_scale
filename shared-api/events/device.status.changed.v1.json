{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/device.status.changed.v1.json",
  "title": "device.status.changed v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "device.status.changed" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "projectId": { "type": ["string", "null"] },
    "pondId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "required": ["deviceCode", "status"],
      "properties": {
        "deviceCode": { "type": "string", "minLength": 1 },
        "status": { "enum": ["online", "offline", "maintenance"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
