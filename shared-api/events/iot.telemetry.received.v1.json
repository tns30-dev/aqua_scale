{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/iot.telemetry.received.v1.json",
  "title": "iot.telemetry.received v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "iot.telemetry.received" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "projectId": { "type": ["string", "null"] },
    "pondId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "required": ["device_code", "seq_no", "measured_at", "ts", "sensor_batches"],
      "properties": {
        "device_code": { "type": "string", "minLength": 1 },
        "seq_no": { "type": "integer", "minimum": 0 },
        "measured_at": { "type": "string", "format": "date-time" },
        "ts": { "type": "integer", "minimum": 0 },
        "sig": { "type": "string" },
        "sensor_batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["port", "readings"],
            "properties": {
              "port": { "type": "string", "minLength": 1 },
              "readings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["parameter", "value"],
                  "properties": {
                    "parameter": { "type": "string", "minLength": 1 },
                    "value": { "type": "number" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
