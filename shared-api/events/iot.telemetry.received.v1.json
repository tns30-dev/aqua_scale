{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/iot.telemetry.received.v1.json",
  "title": "iot.telemetry.received v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "iot.telemetry.received" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "projectId": { "type": "string" },
    "pondId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["deviceId", "seqNo", "measurements", "receivedAt"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1 },
        "deviceCode": { "type": "string" },
        "seqNo": { "type": "integer", "minimum": 0 },
        "messageId": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string" },
        "signatureAlgorithm": { "type": "string" },
        "rawPayload": { "type": ["object", "string"] },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["port", "parameterCode", "value", "measuredAt"],
            "properties": {
              "port": { "type": "string", "minLength": 1 },
              "parameterCode": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "measuredAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
