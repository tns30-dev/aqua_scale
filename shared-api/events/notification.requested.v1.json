{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquashield.local/events/notification.requested.v1.json",
  "title": "notification.requested v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "publishedAt", "source", "correlationId", "projectId", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "notification.requested" },
    "schemaVersion": { "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "projectId": { "type": "string", "minLength": 1 },
    "pondId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["notificationRequestId", "channel", "recipientUserId", "templateCode", "priority"],
      "properties": {
        "notificationRequestId": { "type": "string", "minLength": 1 },
        "alertId": { "type": "string" },
        "channel": { "type": "string", "minLength": 1 },
        "recipientUserId": { "type": "string", "minLength": 1 },
        "templateCode": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
