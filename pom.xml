<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aquashield</groupId>
  <artifactId>aquashield-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AquaShield Platform</name>
  <description>Cloud-native aquaculture monitoring microservices</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.4.5</spring-boot.version>
    <spring-cloud-gcp.version>5.11.0</spring-cloud-gcp.version>
    <grpc.version>1.69.0</grpc.version>
    <protobuf.version>4.29.3</protobuf.version>
  </properties>

  <!-- Java service modules — uncomment as each service is implemented.
       analytics-service (TypeScript), ml-service / llm-service (Python placeholders)
       are intentionally NOT Maven modules. -->
  <modules>
    <module>common</module>
    <module>shared-api</module>
    <module>identity-access-service</module>
    <module>project-service</module>
    <!-- <module>project-service</module> -->
    <!-- <module>pond-service</module> -->
    <!-- <module>sensor-service</module> -->
    <!-- <module>ingestion-service</module> -->
    <!-- <module>notification-service</module> -->
    <!-- <module>realtime-gateway</module> -->
    <!-- <module>audit-service</module> -->
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- required for Spring @PathVariable/@RequestParam name resolution -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- pin: imported BOMs (spring-cloud-gcp) manage an older protobuf runtime,
             which must never be older than our protoc gencode version -->
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>spring-cloud-gcp-dependencies</artifactId>
        <version>${spring-cloud-gcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
