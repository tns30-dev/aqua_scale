{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew check:*)",
      "Bash(mvn test:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(kustomize build:*)",
      "Bash(kubeconform:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud projects list:*)",
      "Bash(gcloud auth list:*)",
      "Bash(buf:*)",
      "Bash(protoc:*)",
      "Bash(trivy:*)",
      "Bash(semgrep:*)",
      "Bash(gitleaks:*)",
      "Bash(python -m pytest:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gcloud:*)",
      "Bash(aws:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(docker push:*)",
      "Bash(argocd:*)",
      "Bash(firebase deploy:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*secret*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)",
      "Read(./**/device-certs/**)"
    ]
  }
}
