# AquaShield local development — copy to .env (git-ignored)
# Cloud deployments use Secret Manager / K8s Secrets, never .env files.

# Postgres (docker compose; host port 5433 — the monolith's local postgres owns 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aquashield
DB_USER=aquashield
DB_PASSWORD=aquashield_local

# Redis (docker compose; host port 6380 — the monolith's local redis owns 6379)
REDIS_HOST=localhost
REDIS_PORT=6380

# Emulators
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=aquashield-local
BIGTABLE_EMULATOR_HOST=localhost:8086

# JWT (local dev only — generate a real keypair, do not use this placeholder)
JWT_ISSUER=aquashield-local
JWT_AUDIENCE=aquashield-api
