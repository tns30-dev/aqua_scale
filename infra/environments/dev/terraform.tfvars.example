# Copy to terraform.tfvars locally before planning/applying dev.
# Do not commit real terraform.tfvars files.

project_id           = "REPLACE_WITH_GCP_PROJECT_ID"
region               = "asia-southeast1"
gke_cluster_location = "asia-southeast1-a"
github_repository    = "tns30-dev/aqua_scale"

# Cost-controlled demo defaults. Adjust only after checking overlap with existing networks.
gke_subnet_cidr         = "10.10.0.0/20"
pod_secondary_cidr      = "10.20.0.0/16"
service_secondary_cidr  = "10.30.0.0/20"
master_ipv4_cidr_block  = "172.16.0.0/28"
node_machine_type       = "e2-standard-2"
min_node_count          = 1
max_node_count          = 2

# Set true only after the project has non-zero Cloud Armor quota.
enable_cloud_armor = false

# Managed GCP data/messaging slice. Defaults stay off so a fresh plan does not
# accidentally create paid data services. Turn these on in local terraform.tfvars
# when capturing managed-service evidence.
enable_cloud_sql   = false
enable_memorystore = false
enable_pubsub      = false
enable_bigtable    = false
enable_bigquery    = false

cloud_sql_tier                = "db-f1-micro"
cloud_sql_deletion_protection = false
redis_memory_size_gb          = 1

# Bigtable development instances are no longer offered by Google Cloud; this
# creates a one-node PRODUCTION instance when enabled. Use only for short
# evidence windows unless budget/quota is confirmed.
bigtable_num_nodes           = 1
bigtable_deletion_protection = false

# AWS IoT/Lambda bridge. Keep disabled until AWS credentials, account ID,
# and the packaged Lambda zip are ready.
enable_aws_iot_bridge = false
aws_region            = "ap-southeast-1"
aws_profile           = null
aws_account_id        = "123456789012"

# Optional. If empty, Terraform expects:
#   aws-iot-bridge/dist/aws-iot-bridge.zip
aws_iot_lambda_zip_path = ""
aws_iot_thing_name      = "aq-dev-simulator-01"
aws_iot_topic_prefix    = "aquashield/dev/telemetry"
aws_iot_topic_filter    = "aquashield/dev/telemetry/+"
